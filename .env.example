# =================================================================
# Kaisen SECURE ADMIN — Environment Configuration Template
# Vishal SecureScan Administration Platform
# =================================================================

# Server Environment
PORT=3000
NODE_ENV=production

# Database Configuration
# Leave blank to automatically use the embedded persistent PostgreSQL engine (PGlite)
# Or provide standard external PostgreSQL connection URI:
# DATABASE_URL=postgresql://kaisen_admin:CHANGE_ME_IN_PRODUCTION@localhost:5432/kaisen_securescan?sslmode=prefer
DATABASE_URL=

# Cryptographic Verifier Secret (HMAC-SHA256)
# MANDATORY: Used exclusively server-side to hash and verify raw client API keys.
# Must be at least 32 bytes (256-bit) of high-entropy cryptographic randomness.
API_KEY_HMAC_SECRET=generate_minimum_32_bytes_random_hex_secret_for_hmac_here

# Access Token JWT Secret (Client Authentication)
# Used to sign short-lived (15 min) client access tokens
JWT_SECRET=generate_high_entropy_jwt_secret_token_here_change_in_production

# Administrator Session Secret (Admin Panel)
# Used for signing and verifying HttpOnly, SameSite, Secure administrator session cookies
ADMIN_SESSION_SECRET=generate_high_entropy_session_cookie_secret_here

# Platform Ownership & Public Configuration
# Safe server-side or public-site configuration values
OWNER_NAME="Vishal Chaudhary"
OWNER_CONTACT_NUMBER="+1 (800) 555-KSEN"
OWNER_EMAIL="vishal@kaisensecurity.com"

# Google Play Integrity & Anti-Tampering Policy Settings
ENFORCE_PLAY_INTEGRITY=false
EXPECTED_PACKAGE_NAME=com.vishal.securescan
EXPECTED_CERT_SHA256=A1:B2:C3:D4:E5:F6:07:18:29:3A:4B:5C:6D:7E:8F:90:A1:B2:C3:D4:E5:F6:07:18:29:3A:4B:5C:6D:7E:8F:90
